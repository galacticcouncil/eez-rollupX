events { worker_connections 256; }
http {
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    upstream api { server ${EXPLORER_API_HOST}:4000; keepalive 8; }
    upstream frontend { server ${EXPLORER_WEB_HOST}:3000; keepalive 8; }
    server {
        listen 8080;
        server_name _;
        absolute_redirect off;
        location = /api {
            proxy_pass http://api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
        }
        location /api/ {
            proxy_pass http://api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
        }
        location /socket/ {
            proxy_pass http://api;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
        location / {
            proxy_pass http://frontend;
            # Next.js HTML responses can carry large preload/CSP headers.
            proxy_buffer_size 32k;
            proxy_buffers 8 32k;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
        }
    }
}
